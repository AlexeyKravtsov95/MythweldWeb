# Copy this file to `.env` (never commit `.env`) and fill in the values.
#
# DISCORD_BOT_TOKEN — bot token from the Discord Developer Portal
# (Applications → Mythweld Bootstrap → Bot → Reset Token). Use a bot
# token only, never a user (self-bot) token.
DISCORD_BOT_TOKEN=

# DISCORD_GUILD_ID — snowflake ID of the Mythweld server
# (Discord → Settings → Advanced → Developer Mode, then right-click
# the server icon → Copy Server ID).
DISCORD_GUILD_ID=
