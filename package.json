{
  "name": "mythweld-web",
  "version": "0.1.0",
  "private": true,
  "description": "Mythweld main website: static Astro + TypeScript site (EN default, RU at /ru/).",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run check && npm run build && npm test",
    "secrets:check": "node scripts/check-secrets.ts && node scripts/check-secrets.ts dist",
    "deploy:plan": "node scripts/deploy/deploy.ts --dry-run",
    "smoke": "node scripts/deploy/smoke.ts"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "node-html-parser": "9.0.5",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
