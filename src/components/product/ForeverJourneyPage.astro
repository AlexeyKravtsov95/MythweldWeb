---
/** Forever Journey overview with a short link to the Book Creator page. */
import BaseLayout from "../../layouts/BaseLayout.astro";
import FigureWithCaption from "../ui/FigureWithCaption.astro";
import ProductAction from "../ui/ProductAction.astro";
import StatusTag from "../ui/StatusTag.astro";
import ProductNext from "./ProductNext.astro";
import SectionHeading from "./SectionHeading.astro";
import { RELEASE } from "../../config/release";
import { SITE } from "../../config/site";
import { getDictionary, localizePath, type Locale } from "../../i18n";
import { ADDON_SCREENSHOTS } from "../../media/catalog";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const copy = t.foreverJourneyPage;
const name = t.home.products.foreverJourney.name;
const curseforge = RELEASE.foreverJourney.curseforge;
const { facts, records, steps, book } = copy;
const recordItems = [
  records.items.levelUps,
  records.items.zones,
  records.items.deaths,
  records.items.bossKills,
  records.items.notes,
];
const stepItems = [steps.items.install, steps.items.play, steps.items.book];
---

<BaseLayout
  locale={locale}
  path="/forever-journey/"
  title={copy.meta.title}
  description={copy.meta.description}
>
  <div class="container product" data-product-page="forever-journey">
    <section class="hero" aria-labelledby="page-title">
      <div class="intro">
        <p class="kind">{copy.kind}</p>
        <h1 id="page-title">{name}</h1>
        <p class="lead">{copy.lead}</p>
      </div>
      <div class="media">
        <FigureWithCaption
          asset={ADDON_SCREENSHOTS.overview}
          {...t.media.addon.overview}
          note={t.media.addonNote}
          sizes="(max-width: 900px) calc(100vw - 2rem), 42rem"
          loading="eager"
        />
      </div>
      <div class="actions">
        <ProductAction
          variant="forever-journey"
          label={t.home.downloadAddon}
          href={SITE.links.curseforge}
          locale={locale}
        />
        <ProductAction
          variant="secondary"
          label={t.home.bookCreatorLinkLabel}
          href={SITE.links.bookCreator}
          locale={locale}
        />
      </div>
      <dl class="facts" aria-label={facts.label}>
        <div>
          <dt>CurseForge</dt>
          <dd>
            <StatusTag
              state={curseforge}
              label={t.release.states[curseforge]}
              framed={false}
            />
          </dd>
        </div>
        <div>
          <dt>{facts.bookCreator}</dt>
          <dd>
            <StatusTag
              state="available"
              label={facts.worksInBrowser}
              framed={false}
            />
          </dd>
        </div>
        <div>
          <dt>{facts.account}</dt>
          <dd>{facts.notNeeded}</dd>
        </div>
      </dl>
    </section>

    <section class="section" aria-labelledby="records">
      <SectionHeading
        number="01"
        id="records"
        title={records.heading}
        text={records.text}
      />
      <div class="records">
        <ul class="chips">
          {recordItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <FigureWithCaption
          asset={ADDON_SCREENSHOTS.chronicle}
          {...t.media.addon.chronicle}
          note={t.media.addonNote}
          sizes="(max-width: 900px) calc(100vw - 2rem), 42rem"
        />
      </div>
      <div class="steps">
        <h3 class="visually-hidden">{steps.heading}</h3>
        <ol>
          {stepItems.map((step, index) => (
            <li>
              <span class="step-number" aria-hidden="true">
                {index + 1}
              </span>
              <span class="step-title">{step.title}</span>
              <span class="step-text">{step.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </div>

  <section class="book" aria-labelledby="book-creator">
    <div class="container book-inner">
      <div class="book-text">
        <p class="book-label">
          <span class="number" aria-hidden="true">
            02
          </span>
          {book.label}
        </p>
        <h2 id="book-creator">{book.heading}</h2>
        <p class="book-lead">{book.text}</p>
      </div>
      <ProductAction
        variant="secondary"
        label={book.action}
        href={localizePath(locale, "/book-creator/")}
        locale={locale}
        forward
      />
    </div>
  </section>

  <div class="container next-wrap">
    <ProductNext locale={locale} target="talentforge" copy={copy.next} />
  </div>
</BaseLayout>

<style>
  .product {
    display: grid;
    gap: var(--space-section);
    padding-block: var(--space-9) var(--space-section);
  }

  /* Hero: text, actions and facts on the left; the in-game slot right. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    grid-template-areas:
      "intro media"
      "actions media"
      "facts media";
    grid-template-rows: auto auto 1fr;
    align-items: start;
    gap: var(--space-5) var(--space-8);
  }

  .intro {
    grid-area: intro;
    display: grid;
    gap: var(--space-3);
  }

  .kind {
    color: var(--color-text-subtle);
    font-size: 0.9375rem;
  }

  h1 {
    font-size: var(--font-size-h1-product);
  }

  .lead {
    color: var(--color-text-muted);
    font-size: var(--font-size-lead);
    line-height: 1.45;
  }

  .media {
    grid-area: media;
  }

  .actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .facts {
    grid-area: facts;
    display: grid;
    margin: 0;
    padding: var(--space-2) var(--space-5) var(--space-3);
    background: var(--color-surface);
    box-shadow: inset 0 var(--edge-product) 0 var(--color-fj-accent);
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - var(--cut-plate)),
      calc(100% - var(--cut-plate)) 100%,
      0 100%
    );
  }

  .facts > div {
    display: grid;
    grid-template-columns: minmax(6rem, 2fr) minmax(0, 5fr);
    align-items: center;
    gap: var(--space-4);
    min-height: var(--size-target-min);
  }

  .facts > div + div {
    border-top: 1px solid var(--color-divider);
  }

  dt {
    color: var(--color-text-subtle);
    font-size: var(--font-size-caption);
  }

  dd {
    margin: 0;
    font-size: var(--font-size-caption);
  }

  .section {
    display: grid;
    gap: var(--space-7);
    padding-top: var(--space-section);
    border-top: 1px solid var(--color-divider);
  }

  /* What it records: the list beside the Chronicle tab in game. */
  .records {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    align-items: start;
    gap: var(--space-8);
  }

  .chips {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    font-weight: var(--font-weight-label);
  }

  .chips li::before {
    content: "";
    flex: 0 0 auto;
    width: var(--space-2);
    height: var(--space-2);
    background: var(--color-fj-accent);
    transform: translateY(-0.1em);
  }

  .steps ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: start;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .step-number,
  .number {
    color: var(--color-brand-bronze);
    font-family: var(--font-mono);
    font-size: var(--font-size-mono);
    font-weight: 500;
  }

  .step-title {
    font-weight: var(--font-weight-label);
  }

  .step-text {
    grid-column: 2;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  /* 02 Book Creator: a sunken band across the page. */
  .book {
    padding-block: var(--space-section);
    background: var(--color-bg-sunken);
  }

  .book-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-8);
  }

  .book-text {
    max-width: 46rem;
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .book-label {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--color-fj-highlight);
    font-size: var(--font-size-caption);
  }

  .book h2 {
    font-size: var(--font-size-h2);
  }

  .book-lead {
    color: var(--color-text-muted);
  }

  .next-wrap {
    padding-block: var(--space-section) var(--space-10);
  }

  @media (max-width: 900px) {
    .product {
      padding-top: var(--space-8);
    }

    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "intro"
        "media"
        "actions"
        "facts";
      grid-template-rows: none;
    }

    .records,
    .steps ol {
      grid-template-columns: minmax(0, 1fr);
    }

    .records {
      gap: var(--space-6);
    }

    /* One row of five above the Chronicle, no lone chip at 768 px. */
    .chips {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .steps ol {
      gap: var(--space-4);
    }

    .next-wrap {
      padding-bottom: var(--space-9);
    }
  }

  @media (max-width: 600px) {
    .product {
      padding-top: var(--space-6);
    }

    .chips {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
