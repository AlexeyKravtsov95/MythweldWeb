---
/**
 * Plan → Play → Remember strip at the end of a product page (v3.2, pages 27
 * and 59): one line about the next step and a link to the other product
 * page in the same locale. The left edge takes that product's colour.
 */
import ProductAction from "../ui/ProductAction.astro";
import {
  getDictionary,
  localizePath,
  type Locale,
  type NextProductCopy,
} from "../../i18n";

interface Props {
  locale: Locale;
  /** The other product page, the one this strip links to. */
  target: "talentforge" | "forever-journey";
  copy: NextProductCopy;
}

const { locale, target, copy } = Astro.props;
const t = getDictionary(locale);
---

<section
  class="next"
  data-product={target}
  aria-label={t.product.flowLabel}
  data-next
>
  <div class="text">
    <p class="label">{t.product.flowLabel}</p>
    <p class="line">{copy.text}</p>
  </div>
  <ProductAction
    variant="secondary"
    label={copy.action}
    href={localizePath(locale, `/${target}/`)}
    locale={locale}
    forward
  />
</section>

<style>
  .next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    padding: var(--space-6) var(--space-7);
    background: var(--color-surface);
    box-shadow: inset var(--edge-product) 0 0 var(--next-edge);
  }

  [data-product="talentforge"] {
    --next-edge: var(--color-tf-accent);
  }

  [data-product="forever-journey"] {
    --next-edge: var(--color-fj-accent);
  }

  .text {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .label {
    color: var(--color-text-subtle);
    font-size: var(--font-size-caption);
  }

  .line {
    font-size: var(--font-size-lead);
    font-weight: var(--font-weight-label);
    line-height: 1.3;
  }

  @media (max-width: 600px) {
    .next {
      padding: var(--space-5);
    }
  }
</style>
