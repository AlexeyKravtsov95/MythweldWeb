---
/**
 * Numbered section heading of the product pages (v3.2, "01 Nine classes"):
 * the mono number in bronze, the h2 and an optional short lead.
 */
interface Props {
  /** Two-digit section number, e.g. "01". */
  number: string;
  /** Id of the h2: the section is labelled by it. */
  id: string;
  title: string;
  text?: string;
}

const { number, id, title, text } = Astro.props;
---

<header class="section-heading">
  <span class="number" aria-hidden="true">
    {number}
  </span>
  <h2 id={id}>{title}</h2>
  {text && <p class="text">{text}</p>}
</header>

<style>
  .section-heading {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    max-width: 46rem;
  }

  .number {
    color: var(--color-brand-bronze);
    font-family: var(--font-mono);
    font-size: var(--font-size-mono);
    font-weight: 500;
  }

  h2 {
    font-size: var(--font-size-h2);
  }

  .text {
    grid-column: 2;
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .section-heading {
      grid-template-columns: minmax(0, 1fr);
    }

    .text {
      grid-column: auto;
    }
  }
</style>
