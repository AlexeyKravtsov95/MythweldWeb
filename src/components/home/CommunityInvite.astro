---
/**
 * Small invitation below the product content of the home page (DISCORD-M1):
 * one line about the Mythweld Discord community and a link to the Community
 * page of the same locale. The product plates above keep their order and
 * composition; the Discord invite itself stays on the Community page.
 */
import ProductAction from "../ui/ProductAction.astro";
import { getDictionary, localizePath, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const invite = getDictionary(locale).home.communityInvite;
---

<section
  class="invite"
  aria-labelledby="community-invite"
  data-community-invite
>
  <div class="text">
    <h2 id="community-invite">{invite.heading}</h2>
    <p>{invite.text}</p>
  </div>
  <ProductAction
    variant="secondary"
    label={invite.action}
    href={localizePath(locale, "/community/")}
    locale={locale}
    forward
  />
</section>

<style>
  .invite {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-section);
    padding: var(--space-6) var(--space-7);
    background: var(--color-surface);
    box-shadow: inset var(--edge-product) 0 0 var(--color-brand-bronze);
  }

  .text {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  h2 {
    font-size: var(--font-size-h2);
  }

  p {
    max-width: 42rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .invite {
      margin-top: var(--space-8);
      padding: var(--space-5);
    }
  }
</style>
