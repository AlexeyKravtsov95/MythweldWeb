---
/**
 * Forever Journey plate of the home page. The addon is shown by its
 * Overview tab in game, a capture from the CurseForge gallery reused with
 * the owner's permission (blocker B1) and captioned as such; Book Creator
 * is presented as the related tool with pages of a sample PDF it produced,
 * never as addon screenshots. A text link leads to the product
 * page; the CurseForge download stays the plate's main action.
 *
 * The sample is the synthetic English demo book in every locale: the only
 * Russian sample carries a name from a real character archive (blocker B4)
 * and stays off promotional pages until the owner approves it.
 */
import { Picture } from "astro:assets";
import FigureWithCaption from "../ui/FigureWithCaption.astro";
import ProductAction from "../ui/ProductAction.astro";
import ProductPlate from "../ui/ProductPlate.astro";
import StatusTag from "../ui/StatusTag.astro";
import { RELEASE } from "../../config/release";
import { SITE } from "../../config/site";
import { getDictionary, localizePath, type Locale } from "../../i18n";
import {
  ADDON_SCREENSHOTS,
  pickMedia,
  type MediaAsset,
} from "../../media/catalog";
import { imageFor } from "../../media/images";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const fj = t.home.products.foreverJourney;
const bc = t.home.products.bookCreator;
const curseforge = RELEASE.foreverJourney.curseforge;
const sample = t.home.bookSample;
const pages = [
  { asset: pickMedia("bc-sample-cover", "en"), alt: sample.coverAlt },
  { asset: pickMedia("bc-sample-chapter", "en"), alt: sample.chapterAlt },
].filter((page): page is { asset: MediaAsset; alt: string } =>
  Boolean(page.asset),
);
---

<ProductPlate
  product="forever-journey"
  name={fj.name}
  kind={fj.kind}
  id="forever-journey"
>
  <StatusTag
    slot="status"
    state={curseforge}
    label={t.home.curseforgeStates[curseforge]}
  />

  <FigureWithCaption
    asset={ADDON_SCREENSHOTS.overview}
    {...t.media.addon.overview}
    note={t.media.addonNote}
    sizes="(max-width: 900px) calc(100vw - 2rem), 36rem"
  />
  <p class="summary">{fj.summary}</p>
  <a class="more" href={localizePath(locale, "/forever-journey/")}>
    {t.home.exploreForeverJourney}&nbsp;<span aria-hidden="true">→</span>
  </a>

  <section class="book" aria-labelledby="book-creator">
    <div class="sheets">
      {pages.map((page) => (
        <Picture
          src={imageFor(page.asset)}
          alt={page.alt}
          widths={[200, 400]}
          sizes="(max-width: 600px) 42vw, 6rem"
          formats={["avif", "webp"]}
          loading="lazy"
          decoding="async"
        />
      ))}
    </div>
    <div class="book-text">
      <h3 id="book-creator">{bc.name}</h3>
      <p>{bc.summary}</p>
      <p class="sample-note">{sample.caption}</p>
    </div>
  </section>

  <Fragment slot="actions">
    <ProductAction
      variant="forever-journey"
      label={t.home.downloadAddon}
      href={SITE.links.curseforge}
      locale={locale}
    />
    <ProductAction
      variant="secondary"
      label={t.home.bookCreatorLinkLabel}
      href={SITE.links.bookCreator}
      locale={locale}
    />
  </Fragment>
</ProductPlate>

<style>
  .summary {
    color: var(--color-text);
  }

  /* Inline text, not flex: when the RU label wraps at 320 px, the arrow
     stays after the last word instead of drifting to the right edge. */
  .more {
    display: inline-block;
    align-self: flex-start;
    min-height: var(--size-target-min);
    padding-block: var(--space-2);
    margin-top: calc(-1 * var(--space-2));
    color: var(--color-fj-highlight);
    font-weight: var(--font-weight-label);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .more:hover {
    color: var(--color-fj-action-hover);
  }

  .book {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .sheets {
    display: grid;
    grid-template-columns: repeat(2, 6rem);
    gap: var(--space-3);
  }

  .sheets :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .sample-note {
    color: var(--color-text-subtle);
    font-size: var(--font-size-caption);
    line-height: var(--line-height-caption);
  }

  .book-text {
    display: grid;
    gap: var(--space-1);
    color: var(--color-text-muted);
  }

  h3 {
    color: var(--color-text);
    font-size: 1.1875rem;
    letter-spacing: normal;
  }

  @media (max-width: 600px) {
    .book {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }

    .sheets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
